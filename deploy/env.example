# Copy to /etc/eshop.env on the Hetzner server. Never commit real keys.
# After editing: systemctl restart eshop

SHOP_NAME=Print Me Maybe
SHOP_TIMEZONE=Europe/Nicosia
DATA_DIR=/var/lib/eshop
ENV=production
SESSION_HTTPS_ONLY=1
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
# Optional: custom studio URL prefix (default /studio). Restart after changing.
# ADMIN_PATH=/studio
# Optional: hours before studio login expires (cart cookie stays 7 days).
# ADMIN_SESSION_HOURS=8
# Optional: copy nightly backups off this disk (directory or user@host:/path).
# BACKUP_REMOTE=
NOTIFY_EMAIL=dimitrioupanagiotis@outlook.com
RESEND_API_KEY=
RESEND_FROM=Print Me Maybe <orders@print-me-maybe.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
